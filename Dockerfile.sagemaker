FROM python:3.12-slim

WORKDIR /opt/ml/model

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY docker/model/ /opt/ml/model/

RUN pip install --no-cache-dir \
    mlflow==3.15.1 \
    numpy==2.5.1 \
    pandas==2.3.3 \
    psutil==7.2.2 \
    rich==15.0.0 \
    scikit-learn==1.9.0 \
    scipy==1.18.0 \
    skops==0.14.0 \
    fastapi \
    uvicorn

EXPOSE 8080

ENTRYPOINT ["python", "/opt/ml/model/serve.py"]
